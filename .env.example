# ─── LLM Providers (optional — leave blank for mock mode) ───
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── Financial Guardrails ───
REFUND_AUTO_APPROVE_CAP=150.00
REFUND_HUMAN_APPROVAL_CAP=500.00
MAX_REFUNDS_ROLLING_WINDOW=3
REFUND_ROLLING_WINDOW_DAYS=30

# ─── Logic Guardrails ───
MAX_CONVERSATION_TURNS=8
LOOP_DETECTION_THRESHOLD=3
AGENT_TIMEOUT_SECONDS=45

# ─── Router ───
INTENT_CONFIDENCE_THRESHOLD=0.72

# ─── Session ───
SESSION_TTL_SECONDS=1800

# ─── Database ───
DATABASE_URL=sqlite:///./nexus.db

# ─── Audit Log ───
AUDIT_LOG_PATH=./audit.jsonl

# ─── API ───
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# ─── Redis (optional — in-memory sessions used if not set) ───
REDIS_URL=

# ─── Security ───
SECRET_KEY=nexus-dev-secret-change-in-production
